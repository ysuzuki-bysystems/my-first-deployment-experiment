[Unit]
Description=My home page.
# Podman ネットワークが作成されていること
Requires=test-network.service
# Podman ネットワーク作成後に起動
After=test-network.service
# イメージが存在しない場合、起動できない
AssertPathExists=/usr/local/share/test/test-app.tar.xz

[Service]
# 起動前にイメージを読み込みタグを付与
ExecStartPre=/usr/local/bin/podman-load-tag /usr/local/share/test/test-app.tar.xz localhost/test-app

[Container]
ContainerName=test-app
# コンテナの環境変数が指定されたファイル
# 環境により異なる変数を指定する
EnvironmentFile=/etc/sysconfig/test-app
# ExecStartPre で読み込んだイメージをもとに起動
Image=localhost/test-app
Network=test-network
#NetworkAlias=my-image # Not supported yet. (Podman 4.9)
#Pod=my-pod.pod # Not supported yet. (Podman 4.9)
# NetworkAlias が使えないため、 podman の引数に直接指定する。
PodmanArgs=--network-alias test-app
LogDriver=journald

# 他指定すべきものがあれば指定する (pull のポリシーなど)
# see https://docs.podman.io/en/v4.9.3/markdown/podman-systemd.unit.5.html

[Install]
WantedBy=test.target

# vim:set ft=systemd:
